HF_DATASET_NAME=ai4bharat/MSMARCO-XI
HF_DATASET_CONFIG=default
HF_DATASET_SPLIT=validation
HF_SAMPLE_SIZE=10
HF_STREAMING=true
INGESTION_DEVELOPMENT_MODE=true
HF_REVISION=main
HF_CACHE_DIR=
HF_TRUST_REMOTE_CODE=false
# HF_LOADER_BACKEND (or DATASET_BACKEND): 'dataset_server' (fast preview <=100 rows) or 'hf_datasets' (large/full streaming)
HF_LOADER_BACKEND=dataset_server
DATASET_BACKEND=hf_datasets
HF_DATASET_SERVER_URL=https://datasets-server.huggingface.co
LOG_LEVEL=INFO
CHUNK_STRATEGY=metadata
CHUNK_MAX_SIZE=256
CHUNK_OVERLAP=32
CHUNK_MIN_SIZE=1
CHUNK_SEMANTIC_THRESHOLD=0.70
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE=
EMBEDDING_CACHE_PATH=.cache/embeddings.sqlite3
EMBEDDING_CACHE_ENABLED=true
QDRANT_URL=.cache/qdrant
QDRANT_COLLECTION=voice_rag_chunks
QDRANT_API_KEY=
QDRANT_RECREATE=false
QDRANT_TIMEOUT=60
QDRANT_UPSERT_BATCH_SIZE=64
BM25_K1=1.5
BM25_B=0.75
BM25_INDEX_PATH=.cache/bm25_index.json
BM25_LOWERCASE=true
BM25_UNICODE_NORMALIZATION=NFC
BM25_MIN_TOKEN_LENGTH=1
HYBRID_VECTOR_TOP_K=20
HYBRID_BM25_TOP_K=20
HYBRID_FINAL_TOP_K=10
HYBRID_RRF_K=60
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=
RERANKER_TRUST_REMOTE_CODE=true
RERANKER_CANDIDATE_TOP_K=20
RERANKER_FINAL_TOP_K=5
RERANKER_BATCH_ALL_CANDIDATES=true
RERANKER_WARMUP_ENABLED=true
RERANKER_WARMUP_CANDIDATES=1
HYBRID_CHUNKING_STRATEGY=metadata

# Application layer. Keep real credentials in .env or the process environment.
# Supported providers: groq, local, gemini
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# For local LLM provider (models/qwen-0.5b, models/smollm2-135m, etc.)
# LLM_PROVIDER=local
# LLM_MODEL=models/qwen-0.5b
GROQ_API_KEY=
GEMINI_API_KEY=
STT_PROVIDER=sarvam
SARVAM_API_KEY=
APP_TOP_K=3
APP_CANDIDATE_TOP_K=5
APP_AUTO_INDEX=false
APP_INDEX_SAMPLE_SIZE=2
APP_INDEX_RECREATE=false
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
